# Local .terraform directories
**/.terraform/*
.terraform.tfstate.lock.info

# State files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Plan artifacts
*.tfplan
tfplan.bin
plan.json
plan.txt
planlog.txt

# Variable files that may contain secrets
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
