            "rego": "package workspaces\n\n# deny\ndeny[msg] {\n  # if the provisioner is terraform\n  input.workspace.provisioner == \"awscdk\"\n  # and the version is greater than 1.5.4\n  semver.compare(input.workspace.provisioner_version, \"2.1108.0\") == -1\n  msg := sprintf(\"the version was %s but the policy specifies \u003e= 2.1108.0\", [input.workspace.provisioner_version])\n}\n",
